<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView style="@style/Etiqueta" android:layout_marginTop="0dp" android:text="Nombre *" />
            <EditText
                android:id="@+id/etNombre"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Etiqueta" android:text="Apellido *" />
            <EditText
                android:id="@+id/etApellido"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Etiqueta" android:text="DNI *" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDni"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Escribí aquí..."
                    android:inputType="number"
                    android:maxLength="8" />

                <Button
                    android:id="@+id/btnVerificarDni"
                    style="@style/BotonBuscar"
                    android:layout_marginStart="8dp"
                    android:text="Verificar" />
            </LinearLayout>

            <TextView style="@style/Etiqueta" android:text="Teléfono *" />
            <EditText
                android:id="@+id/etTelefono"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="phone" />

            <TextView style="@style/Etiqueta" android:text="Email *" />
            <EditText
                android:id="@+id/etEmail"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="textEmailAddress" />

            <TextView style="@style/Etiqueta" android:text="Dirección *" />
            <EditText
                android:id="@+id/etDireccion"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="textPostalAddress" />

            <TextView style="@style/Etiqueta" android:text="Fecha de nacimiento *" />
            <EditText
                android:id="@+id/etFechaNacimiento"
                style="@style/Campo"
                android:clickable="true"
                android:focusable="false"
                android:hint="Seleccionar fecha"
                android:inputType="none" />

            <CheckBox
                android:id="@+id/cbAptoMedico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Apto médico presentado"
                android:textColor="@color/texto_principal" />

            <Button
                android:id="@+id/btnGuardarSocio"
                style="@style/BotonPrimario"
                android:layout_marginTop="20dp"
                android:text="Guardar y cobrar cuota" />

            <Button
                android:id="@+id/btnCancelarSocio"
                style="@style/BotonOscuro"
                android:layout_marginTop="8dp"
                android:text="Cancelar" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
