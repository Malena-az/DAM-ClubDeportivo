<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola, Admin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRegistrarSocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar socio" />

        <Button
            android:id="@+id/btnRegistrarNoSocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar no socio"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCobrarCuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cobrar cuota"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCobrarActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cobrar actividad"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carnet digital"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>