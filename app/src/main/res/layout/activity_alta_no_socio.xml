<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView style="@style/Etiqueta" android:layout_marginTop="0dp" android:text="Nombre *" />
            <EditText
                android:id="@+id/etNombreNoSocio"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Etiqueta" android:text="Apellido *" />
            <EditText
                android:id="@+id/etApellidoNoSocio"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Etiqueta" android:text="DNI *" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDniNoSocio"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Escribí aquí..."
                    android:inputType="number"
                    android:maxLength="8" />

                <Button
                    android:id="@+id/btnVerificarDniNoSocio"
                    style="@style/BotonBuscar"
                    android:layout_marginStart="8dp"
                    android:text="Verificar" />
            </LinearLayout>

            <TextView style="@style/Etiqueta" android:text="Teléfono *" />
            <EditText
                android:id="@+id/etTelefonoNoSocio"
                style="@style/Campo"
                android:hint="Escribí aquí..."
                android:inputType="phone" />

            <TextView style="@style/Etiqueta" android:text="Observaciones" />
            <EditText
                android:id="@+id/etObservaciones"
                style="@style/Campo"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:hint="Escribí aquí..."
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="12dp" />

            <Button
                android:id="@+id/btnGuardarNoSocio"
                style="@style/BotonPrimario"
                android:layout_marginTop="20dp"
                android:text="Guardar" />

            <Button
                android:id="@+id/btnLimpiarNoSocio"
                style="@style/BotonOscuro"
                android:layout_marginTop="8dp"
                android:text="Limpiar" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
