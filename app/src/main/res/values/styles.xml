<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="EstiloInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textSize">@dimen/texto_etiqueta</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="EstiloBotonPrimario">
        <item name="android:backgroundTint">@color/verde</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/texto_boton</item>
    </style>

    <style name="EstiloBotonSecundario">
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/texto_boton</item>
    </style>

    <style name="EstiloTitulo">
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="EstiloSubtitulo">
        <item name="android:textSize">@dimen/texto_subtitulo</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="EstiloTarjeta">
        <item name="android:background">@color/white</item>
        <item name="android:padding">@dimen/padding_tarjeta</item>
        <item name="android:layout_marginBottom">@dimen/margen_tarjeta</item>
    </style>

    <style name="EstiloEstado">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/texto_insignia</item>
    </style>

    <!-- ===== Estilos unificados de formularios (todas las pantallas los usan) ===== -->
    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/club_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Selector">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_spinner</item>
    </style>

    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/verde</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/texto_boton</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="BotonOscuro" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/club_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/texto_boton</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="BotonClaro" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/club_off_white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/texto_boton</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="BotonBuscar" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:backgroundTint">@color/club_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="ChipEstado">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/texto_insignia</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
