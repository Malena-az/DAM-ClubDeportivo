<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ClubDeportivo"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">
        <activity
            android:name=".registro.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".registro.AltaSocioActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".registro.AltaNoSocioActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".registro.MenuActivity" android:exported="false" />
        <activity android:name=".consultas.ListadoSociosActivity" android:exported="false" />
        <activity android:name=".consultas.VencimientosActivity" android:exported="false" />
        <activity android:name=".consultas.PerfilActivity" android:exported="false" />

    </application>

</manifest>